{
  "name": "dashboard-natua",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "check:secrets": "bash scripts/check-forbidden-files.sh",
    "dashboard:update": "tsx src/data-pipeline/cli.ts update",
    "dashboard:update:check": "tsx src/data-pipeline/cli.ts check",
    "dashboard:rollback": "tsx src/data-pipeline/cli.ts rollback",
    "docs:metricas": "python3 scripts/gerar-dicionario-metricas.py",
    "check:tokens": "python3 scripts/auditar-tokens-css.py"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "multer": "^2.2.0",
    "vite": "^6.2.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
